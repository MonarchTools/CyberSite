
# کلید تصادفی بسازید: python -c "import secrets; print(secrets.token_hex(32))"
# بدون کلید قوی (حداقل 32 کاراکتر) سایت خارج از حالت توسعه اجرا نمی‌شود.
SECRET_KEY=
FLASK_DEBUG=0

# --- پرداخت ---
# zarinpal (پیش‌فرض) یا mock (فقط در حالت توسعه با FLASK_DEBUG=1)
PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=
# برای آزمایش با سندباکس زرین‌پال مقدار 1 بگذارید
ZARINPAL_SANDBOX=0
# آدرس عمومی سایت برای بازگشت از درگاه، مثلاً https://example.ir
SITE_URL=

# --- امنیت ---
# فقط وقتی سایت روی HTTPS است 1 بگذارید (با SITE_URL=https://... خودکار فعال می‌شود)
SESSION_COOKIE_SECURE=
# تعداد پروکسی‌های معتبر جلوی برنامه (Nginx = 1). پشت پروکسی نیستید؟ 0 بماند.
TRUSTED_PROXY_COUNT=0

# --- اعلان ایمیلی (اختیاری) ---
# اگر MAIL_SERVER خالی باشد هیچ ایمیلی فرستاده نمی‌شود.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# starttls (پورت 587) | ssl (پورت 465) | none
MAIL_SECURITY=starttls
# آدرس فرستنده؛ اگر خالی باشد از MAIL_USERNAME استفاده می‌شود
MAIL_FROM=
# اعلان سفارش جدید و پیام جدید به این آدرس می‌رود
ADMIN_NOTIFY_EMAIL=
